[Unit]
Description=Codex Web UI privileged resource broker request

[Service]
Type=exec
User=root
Slice=system.slice
ExecStart=/usr/local/libexec/codex-web-ui-resource-broker --serve-fd 0
StandardInput=socket
StandardOutput=socket
StandardError=journal
SyslogIdentifier=codex-web-ui-resource-broker
TimeoutStartSec=20s
TimeoutStopSec=5s
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ReadWritePaths=/etc/codex-web-ui /etc/systemd/system/codex-web-ui-workload.slice.d
InaccessiblePaths=-/etc/codex-web-ui/codex-web-ui.env -/etc/codex-web-ui/codex-runner.env -/var/lib/codex-web-ui/data -/var/lib/codex-web-ui/codex-home -/run/docker.sock -/run/containerd
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
RestrictAddressFamilies=AF_UNIX
