# Non-secret deployment shape. Copy to /etc/codex-web-ui/codex-web-ui.env,
# keep mode 0600, then provide the three required secret values out of band.
CODEX_WEB_HOST=127.0.0.1
CODEX_WEB_PORT=3210
CODEX_WEB_PUBLIC_ORIGIN=https://codex.example.com
CODEX_WEB_DATABASE_PATH=/var/lib/codex-web-ui/data/codex-web-ui.sqlite3
CODEX_WEB_ATTACHMENT_STORAGE_PATH=/var/lib/codex-web-ui/data/attachments
CODEX_WEB_PROJECT_ROOTS=/srv/codex-projects
CODEX_WEB_APP_SERVER_SOCKET=/run/codex-web-ui/app-server.sock
CODEX_WEB_CODEX_VERSION_PIN="codex-cli 0.153.4"

# Required secrets. Never commit populated values or pass them on a command
# line. ADMIN_PASSWORD_HASH must be an Argon2id encoded hash.
CODEX_WEB_ADMIN_USERNAME=
CODEX_WEB_ADMIN_PASSWORD_HASH=
CODEX_WEB_SESSION_SECRET=

# Optional voice transcription. This is a separate OpenAI API credential, not
# the Codex device-login session. Leave empty to keep the microphone disabled.
OPENAI_API_KEY=
CODEX_WEB_TRANSCRIPTION_MODEL=gpt-transcribe

# Reserved application bounds. They are configuration contracts for the backend;
# systemd independently enforces the service-level process and memory ceiling.
CODEX_WEB_MAX_CONCURRENT_TURNS=2
CODEX_WEB_EVENT_RETENTION_PER_THREAD=1000
CODEX_WEB_MAX_EVENT_BYTES=32768
CODEX_WEB_HEALTH_PATH=/api/health

# Soft shared-host disk guards. They fail admission/startup and the periodic
# storage monitor stops the service after a violation. A host filesystem quota
# is still required for a hard bound because checks cannot prevent a sudden
# write burst between monitor runs.
CODEX_WEB_MIN_FREE_BYTES=5368709120
CODEX_WEB_MAX_DATABASE_BYTES=2147483648
CODEX_WEB_MAX_RELEASES=5
